# =============================================================================
# AI RAG Toolkit Configuration
# =============================================================================
# Copy this file to .env and customize for your environment.
# All RAG_ prefixed variables are optional - defaults are shown in comments.

# =============================================================================
# API Keys
# =============================================================================

# OpenAI API key (used for embeddings and chat when AI is enabled)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# =============================================================================
# AI Feature Toggle
# =============================================================================

# Set to false to use BM25 search only (no OpenAI API calls)
# When disabled, the system works without any external API dependencies
RAG_AI_ENABLED=true

# =============================================================================
# Database
# =============================================================================

# Path to SQLite database file
# RAG_DATABASE_PATH=rag_system.db

# =============================================================================
# Crawler Settings
# =============================================================================

# Delay between HTTP requests in seconds (be nice to servers)
# RAG_CRAWL_DELAY_SECONDS=1.0

# Maximum pages to crawl (use --unlimited flag to override)
# RAG_MAX_PAGES=1000

# Comma-separated list of allowed domains (empty = allow start URL domain only)
# RAG_ALLOWED_DOMAINS=docs.example.com,api.example.com

# Comma-separated path prefixes to exclude from crawling
# RAG_EXCLUDED_PATHS=/api/,/static/

# Comma-separated path prefixes to include (empty = include all)
# RAG_INCLUDED_PATHS=/docs/,/guide/

# Retry settings for transient HTTP errors
# RAG_CRAWLER_MAX_RETRIES=3
# RAG_CRAWLER_RETRY_DELAY=1.0
# RAG_CRAWLER_RETRY_STATUS_CODES=500,502,503,504

# =============================================================================
# Chunking Settings
# =============================================================================

# Character-based chunk sizes
# RAG_SMALL_CHUNK_SIZE=500
# RAG_LARGE_CHUNK_SIZE=2000
# RAG_CHUNK_OVERLAP=100

# Token-based chunking (alternative to character-based)
# RAG_USE_TOKEN_CHUNKING=false
# RAG_SMALL_CHUNK_TOKENS=128
# RAG_LARGE_CHUNK_TOKENS=512
# RAG_CHUNK_OVERLAP_TOKENS=25

# =============================================================================
# Search Settings
# =============================================================================

# BM25 algorithm parameters
# RAG_BM25_K1=1.5
# RAG_BM25_B=0.75

# Hybrid search weights (must sum to 1.0 when AI is enabled)
# RAG_VECTOR_WEIGHT=0.7
# RAG_BM25_WEIGHT=0.3

# Number of results to retrieve and return
# RAG_TOP_K_RETRIEVAL=20
# RAG_TOP_K_FINAL=5
# RAG_MAX_CHUNKS_PER_PAGE=2

# =============================================================================
# Confidence Settings
# =============================================================================

# Minimum confidence score (1-5) required to generate an answer
# RAG_MIN_CONFIDENCE_SCORE=3
# RAG_CONFIDENCE_THRESHOLD=0.5

# =============================================================================
# Embedding Settings (only used when AI is enabled)
# =============================================================================

# Batch size for embedding API calls
# RAG_EMBEDDING_BATCH_SIZE=100
# RAG_EMBEDDING_BATCH_DELAY=0.1
# RAG_EMBEDDING_MAX_RETRIES=3

# =============================================================================
# Caching
# =============================================================================

# HTTP response cache directory (speeds up re-crawls)
# RAG_HTTP_CACHE_DIR=.http_cache

# Query result caching
# RAG_QUERY_CACHE_ENABLED=true
# RAG_QUERY_CACHE_SIZE=100
# RAG_QUERY_CACHE_TTL=3600

# =============================================================================
# Logging
# =============================================================================

# Log format: 'text' for human-readable, 'json' for structured
# RAG_LOG_FORMAT=text
# RAG_LOG_LEVEL=INFO

# Enable metrics collection
# RAG_METRICS_ENABLED=true

# =============================================================================
# SSL Configuration (for custom certificates)
# =============================================================================

# Path to custom SSL certificate
# RAG_SSL_CERT_PATH=/path/to/cert.pem
# RAG_SSL_VERIFY=true

# =============================================================================
# Custom API Endpoints (alternative to OpenAI)
# =============================================================================

# Vector/Embedding API
# RAG_VECTOR_API_ENDPOINT=https://api.openai.com/v1/embeddings
# RAG_VECTOR_API_AUTH_HEADER=Authorization
# RAG_VECTOR_API_AUTH_VALUE=Bearer your-token

# Chat/Completion API
# RAG_CHAT_API_ENDPOINT=https://api.openai.com/v1/chat/completions
# RAG_CHAT_API_AUTH_HEADER=Authorization
# RAG_CHAT_API_AUTH_VALUE=Bearer your-token
